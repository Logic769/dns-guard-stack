[Unit]
Description=dnsguard 解析链路容器 IP / docker0 网关 漂移收敛（审计 §3.3）
Documentation=https://github.com/Logic769/dns-guard-stack
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
# 无差异时零副作用（只读比对后退出 0）；有差异才备份→改写→校验→热重载
ExecStart=/usr/local/sbin/dnsguard-ip-reconcile.sh --apply
Nice=5
TimeoutStartSec=180

[Unit]
Description=dnsguard isolated verifier sidecar
After=network-online.target dnsguard.service
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/dnsguard/verifier.py
WorkingDirectory=/opt/dnsguard
User=root
Restart=always
RestartSec=3

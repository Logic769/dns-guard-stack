  "cards": [
    {
      "dot": "cyan",
      "title": "必经链（实线）",
      "items": [
        "客户端 → AdGuard Home（TLS 终结 + 注入 ECS /24）→ dnsdist（ECS 感知缓存）→ guard 单一入口",
        "guard 是唯一策略实现，AdGuard 没有绕过它的 fallback（fallback_dns: []）",
        "候选源出网前都要经 guard 的准入判定；无独立佐证的放行出口统一把 TTL 压到 60s"
      ]
    },
    {
      "dot": "amber",
      "title": "条件通道（虚线）",
      "items": [
        "aghcf 是 unbound A 的主 forward-addr（Cloudflare + censurfridns 并行），兼国内域名存在性见证",
        "aghdq2 是 unbound A 的备 forward-addr，兼 guard 的 alt 认证备用与 DoQ 核对通道",
        "aghdq（NextDNS）上游握手持续失败，已从 forward-addr 摘除；dnscrypt 只做影子采样"
      ]
    },
    {
      "dot": "slate",
      "title": "部署口径",
      "items": [
        "生产实例用 Docker 默认 bridge（无固定 IP），容器重启会漂移，靠 5 分钟一次的地址对账收敛",
        "AGH 自带缓存必须关：它是域名单键，不按 ECS 分片（实测把 A 省答案返回给 B 省）",
        "配置模板仍是旧形态（dnsdist 公网入口），差异表见 ARCHITECTURE.md 第 8 节"
      ]
    }
  ]

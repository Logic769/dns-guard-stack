  "cards": [
    {
      "dot": "cyan",
      "title": "必经链（实线）",
      "items": [
        "客户端 → dnsdist → 主 AdGuard Home → guard 单一入口",
        "guard 是唯一策略实现，AdGuard 没有绕过它的 fallback",
        "候选源出网前都要经 guard 的准入判定"
      ]
    },
    {
      "dot": "amber",
      "title": "条件通道（虚线）",
      "items": [
        "aghdq2 仅在 hedge 之后并发，不和主通道抢首答",
        "aghcf 提供国内域名存在性见证与 SERVFAIL 快速透传",
        "dnscrypt 只做影子采样，应答不能当作 DNSSEC 证据"
      ]
    },
    {
      "dot": "slate",
      "title": "部署口径",
      "items": [
        "容器全部在 Compose 网络 dnsnet 里用固定 IP，guard 位于宿主网关侧",
        "alt-replica-unb 在 altreplica0（10.99.0.0/24），用于演练与灰度",
        "dnsdist 是宿主 systemd 服务，不是容器；legacy 部署改由 Nginx 承接 853 / 444"
      ]
    }
  ]

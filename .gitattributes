# 这是一个 Linux 部署仓库：脚本、配置、Python 源码一律保持 LF，避免 CRLF 造成
# `bad interpreter: /usr/bin/env bash^M` 之类的故障。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.bash  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.conf  text eol=lf
*.tpl   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.service text eol=lf
*.timer   text eol=lf

# 二进制/证书样例不要做换行转换
*.pem   binary
*.key   binary
*.png   binary
*.jpg   binary
*.gz    binary
*.tgz   binary

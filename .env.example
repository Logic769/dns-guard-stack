# =============================================================================
# dns-guard-stack 部署配置
#   用法：cp .env.example .env   然后按需修改   最后 ./install.sh
#   所有变量都有合理默认值；只有 DNS_DOMAIN 建议显式设置。
# =============================================================================

# ---------------------------------------------------------------- 站点与证书
# DoT(853)/DoH(443,444) 对外域名。必须与 TLS 证书的 CN/SAN 一致。
DNS_DOMAIN=dns.example.com
# 证书路径；两者留空则 install.sh 自动生成自签证书（内网/验证够用）
TLS_CERT=
TLS_KEY=
# 填写邮箱则尝试用 ACME（acme.sh）签发真实证书；留空只做自签
ACME_EMAIL=
# 证书续期定时（cron 表达式，仅当使用 ACME 时写入 root crontab）
ACME_CRON="48 8 * * *"

# ---------------------------------------------------------------------- 目录
# 代码与状态根目录（guard / verifier / 运维脚本 / releases）
CODE_DIR=/opt/dnsguard
# 名单与刷新器目录
LISTS_DIR=/opt/dnscrypt-proxy
# 看板目录
CHAINMON_DIR=/opt/chainmon
DEVFP_DIR=/opt/devfp
# 容器配置与数据
RUNTIME_DIR=/opt/dns-guard-stack/runtime
# 以下留空则由 install.sh 推导（STATE_DIR=$CODE_DIR、VERIFIER_STATE_DIR=$CODE_DIR/verifier-state）
STATE_DIR=
VERIFIER_STATE_DIR=
BACKUP_DIR=

# ---------------------------------------------------------------------- 网络
DOCKER_SUBNET=172.18.0.0/16
ALTREPLICA_SUBNET=10.99.0.0/24
# 留空自动探测 docker0 网关（guard 监听地址；必须与 AGH 里的上游地址一致）
GW_IP=
AGH_IP=172.18.0.2
AGHDQ_IP=172.18.0.6
UNBOUND_A_IP=172.18.0.4
UNBOUND_B_IP=172.18.0.5
UNBOUND_ALT_IP=172.18.0.8
ALTREPLICA_IP=10.99.0.2
DNSCRYPT_IP=172.18.0.9

# ------------------------------------------------------- 宿主端口（可改冲突）
AGH_UI_PORT=3000
AGH_HTTPS_PORT=4443          # 容器 adgh 的 443 → 宿主回环（供 nginx DoH 反代）
AGH_DOT_PORT=8854            # 容器 adgh 的 853 → 宿主回环（DoT 直连 AGH 时用）
AGHDQ_UI_PORT=13000
AGHDQ_DNS_PORT=5533          # aghdq :53 → 宿主回环（guard 见证通道用）
DOT_PORT=853                 # 公网 DoT（nginx stream）
DOH_PORT=444                 # 公网 DoH（nginx http）
CHAINMON_PORT=8787
DEVFP_PORT=8789

# --------------------------------------------- DoT 明文内腿采集（devfp 增强）
# dotfront-spool 抓 nginx :853 → adgh :53 的明文 DNS 内腿，把 EDNS/COOKIE/ECS/PADDING/DO/0x20
# 写成 JSONL；devfp 的 dotfront_spool 配置项必须指向同一个文件才会消费。
# 前置：DoT 内腿为明文（deploy/nginx/tcp/dnsguard-dot-853.conf 的 proxy_pass 直连 adgh:53）。
DOTF_SPOOL=/var/log/dotfront.jsonl

# ---------------------------------------------------------------------- 上游
# A 侧：境外，经 aghdq 走 DoQ（可换成自己的 NextDNS profile 或其它 DoQ/DoH）
UPSTREAM_A_QUIC=quic://dns.nextdns.io
UPSTREAM_A_BOOTSTRAP=223.5.5.5,223.6.6.6
# B 侧：国内 DoT（ip@853#hostname，逗号分隔）
UPSTREAM_B="218.30.118.6@853#dot.360.cn,101.226.4.6@853#dot.360.cn,123.125.81.6@853#dot.360.cn,223.5.5.5@853#dns.alidns.com,223.6.6.6@853#dns.alidns.com,1.12.12.12@853#dns.pub"
# alt：认证备用，需与 A/B 不同运营方
UPSTREAM_ALT="185.95.218.42@853#dns.digitale-gesellschaft.ch,89.233.43.71@853#unicast.censurfridns.dk"
# dnscrypt 加密中继（shadow 对比通道）
DNSCRYPT_SERVERS=cs-nl,cs-fr,dct-de2,cs-dus,cs-london,cs-swe
# 源缓存目录属主 uid。klutchell/dnscrypt-proxy 以 distroless 的 nonroot(65532) 运行，
# 目录由 root 建 ⇒ 不改属主则源列表写不进 cache（permission denied），缓存永久失效。
DNSCRYPT_CACHE_UID=65532
# DNSCrypt 默认走 UDP 443。部分网络（家用宽带、部分云厂商）丢弃出站 UDP 443，
# 表现为容器日志刷 `[cs-*] TIMEOUT` + `dnscrypt-proxy is waiting for at least one
# server to be reachable`，容器 Up 却不解析。此时设 true 改走 TCP 443。
DNSCRYPT_FORCE_TCP=false

# ---------------------------------------------------------------------- 名单
# fetch   = 默认：安装时立即拉取真实名单（v2fly geolocation-cn 域名 + clang.cn/chnroutes2 国内 IP + 否决名单）
#           需要外网；拉取失败或条数不足时会自动退回骨架并告警，不影响部署完成
# minimal = 只生成空骨架，不联网（guard 按"未知即不信任"运行：更安全但多一次见证往返）
LISTS_PROFILE=fetch
#   等价于命令行 ./install.sh --fetch-lists
LISTS_CRON="35 4 * * *"

# --------------------------------------------------------------- 安全与资源
# 国内域名"免存在性见证"档位：
#   none  = 最严：所有国内路由域名都必须见证（最保守，延迟略高）
#   known = 默认：国别后缀(.cn 等) + 人工白名单(cn-trust-allow.txt)免见证，其余要见证
#   all   = 旧行为：所有国内路由域名免见证（不推荐）
CN_TRUST_MODE=known
# 国内域名路由判定的名单档位：enforce = 用 typed 名单（推荐）/ off = 不做国内分流
CN_EXIST_MODE=enforce
# 内存上限（MiB）：guard / verifier
GUARD_MEMORY_MAX=192
GUARD_MEMORY_HIGH=160
VERIFIER_MEMORY_MAX=128
VERIFIER_MEMORY_HIGH=100
# 看板与其它组件内存上限（MiB）
CHAINMON_MEMORY_MAX=256
DEVFP_MEMORY_MAX=176
# AdGuard Home 面板密码（首次安装写入 bcrypt 哈希；留空则安装后首次登录设置）
AGH_ADMIN_USER=admin
AGH_ADMIN_PASSWORD=
# 看板 Basic Auth（供 /chain/ 与 /devices/ 使用；留空则不启用鉴权）
DASH_USER=admin
DASH_PASSWORD=
# 是否让 install.sh 直接把 nginx 片段写入站点配置并 reload
INSTALL_NGINX=0
# nginx 站点配置目录（宝塔默认如下；其它发行版按需改）
NGINX_VHOST_DIR=/www/server/panel/vhost/nginx
NGINX_BIN=nginx

TZ=Asia/Shanghai
